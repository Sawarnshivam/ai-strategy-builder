# Copy to .env.prod and fill in real values before deploying.
# docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# Database
POSTGRES_USER=backtest
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=backtest_db

# Auth — MUST be a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret

# Anthropic — leave blank to use the fake client (spec mode only)
ANTHROPIC_API_KEY=

# CORS — the public origin the frontend is served from
CORS_ORIGINS=http://localhost:3000

# Frontend build-time API URL — where the browser reaches the backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1